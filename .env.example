APP_NAME=ExpenseAI
DATABASE_URL=sqlite:///./expenseai.db
ENVIRONMENT=development
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Comma-separated browser origins. Leave empty for same-origin development.
CORS_ALLOWED_ORIGINS=
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
# Comma-separated trusted reverse-proxy IPs; do not use '*' unless the network is fully controlled.
TRUSTED_PROXY_IPS=127.0.0.1
# Use local for deterministic built-in analysis, or openai_compatible with a private API key.
AI_PROVIDER=local
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1
AI_TIMEOUT_SECONDS=20
